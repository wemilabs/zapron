# OpenAlex API key (required). Create a free account at https://openalex.org/settings/api
OPENALEX_API_KEY=

# OpenAlex API base URL
OPENALEX_API_BASE_URL=

# Semantic Scholar API key (optional). Raises rate limits from 1 req/sec to ~100 req/sec.
# Create one at https://www.semanticscholar.org/product/api#api-key
SEMANTIC_SCHOLAR_API_KEY=

# Semantic Scholar API base URL
SEMANTIC_SCHOLAR_API_BASE_URL=

# xAI (Grok) API key (required for AI summaries). Create one at https://x.ai/api
XAI_API_KEY=
